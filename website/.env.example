# Copy this file to .env for local development. Never commit real credentials.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Use Qdrant Cloud when both variables are set. Leave QDRANT_API_KEY blank for local Qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docusaurus_docs
