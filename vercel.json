{
  "version": 2,
  "builds": [
    {
      "src": "website/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build",
        "buildCommand": "npm run build --workspace=website",
        "outputDirectory": "website/build"
      }
    }
  ],
  "functions": {
    "website/api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/website/api/$1.ts"
    }
  ],
  "installCommand": "npm install"
}
