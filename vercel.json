{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace=website",
  "outputDirectory": "website/build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/website/api/:path*.ts"
    }
  ]
}
